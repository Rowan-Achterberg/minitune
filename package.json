{
  "name": "minitune",
  "version": "1.0.0",
  "description": "MiniTune 小窗口 MP3 播放器：本地音乐 + 免费在线音乐，歌单与歌曲地址经 GitHub 多机同步",
  "main": "main.js",
  "author": "MiniTune",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/test.js",
    "dist:x64": "electron-builder --win --x64 --publish never",
    "dist:arm64": "electron-builder --win --arm64 --publish never"
  },
  "dependencies": {
    "music-metadata": "7.14.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.minitune.player",
    "productName": "MiniTune",
    "artifactName": "MiniTune-Setup-${version}-${arch}.${ext}",
    "files": ["main.js", "preload.js", "lib/**", "ui/**", "build/icon.png"],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MiniTune",
      "language": "2052"
    }
  }
}
